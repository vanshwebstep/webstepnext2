# Webstep Solutions - Apache Server Configuration & 301 Redirects (Live Root)
RewriteEngine On
RewriteBase /
DirectorySlash On

# 301 Redirect old demo URLs to production root
RewriteRule ^demo/webstepnext/?(.*)$ /$1 [R=301,L]

# 301 Permanent Redirects for Old / Alias URLs to Final Production URLs
RewriteRule ^b2b-sales/?$ /hire-dedicated-developers/ [R=301,L]
RewriteRule ^b2b/?$ /hire-dedicated-developers/ [R=301,L]
RewriteRule ^services/wordpress-website/?$ /services/wordpress/ [R=301,L]
RewriteRule ^services/laravel-development/?$ /services/laravel/ [R=301,L]
RewriteRule ^services/shopify-development/?$ /services/shopify/ [R=301,L]
RewriteRule ^services/woocommerce-development/?$ /services/woocommerce/ [R=301,L]
RewriteRule ^services/full-stack-development/?$ /fullstack/ [R=301,L]
RewriteRule ^services/branding/?$ /services/brand-design/ [R=301,L]
RewriteRule ^hire-full-time-developers/?$ /hire-dedicated-developers/ [R=301,L]
RewriteRule ^services/ai/?$ /services/ai-powered-websites/ [R=301,L]
RewriteRule ^contact/?$ /contactus/ [R=301,L]
RewriteRule ^privacy/?$ /privacy-policy/ [R=301,L]
RewriteRule ^terms/?$ /terms-and-conditions/ [R=301,L]

# Static export / SPA fallback
RewriteRule ^index\.html$ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
